# GoDeeper Backend Environment Variables
# Copy this file to `.env` and fill in your own values. Never commit real keys.

# Database
# Cloud: use your Supabase pooler connection string.
# Local: `npx supabase start` prints the local connection string.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54322/postgres

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Encryption key for user API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-key

# Server
PORT=3001
NODE_ENV=development

# Browser origin allow-list for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Experimental routes (knowledge graph). Keep false for MVP.
EXPERIMENTAL_ROUTES=false

# Admin — comma-separated emails
ADMIN_EMAILS=admin@example.com

# Optional: hosted AI. Used only when the user has no BYOK key; consumes credits.
HOSTED_AI_API_KEY=
HOSTED_AI_BASE_URL=
HOSTED_AI_PROVIDER=openai
HOSTED_AI_MODEL=

# Optional: question depth evaluation (JEV).
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.80
JEV_TIMEOUT_MS=2500
JEV_DAILY_LIMIT_PER_USER=200
# Development only: set to qualified or normal to skip the real request.
JEV_MOCK_RESULT=

# Optional: note OCR (OXR).
OXR_BASE_URL=
OXR_API_KEY=
OXR_TIMEOUT_MS=120000
