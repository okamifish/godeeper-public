# GoDeeper Frontend Environment Variables
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: override API timeout in milliseconds (default: 30000)
# NEXT_PUBLIC_API_TIMEOUT=30000

# Supabase — local development example (matches `npx supabase start` defaults).
# Cloud: replace both values with the project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Optional: comma-separated admin emails, used to reveal admin entry points.
# NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
